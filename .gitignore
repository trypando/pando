# Build output
/bin/
/dist/
/pando

# Console build, embedded into internal/console at build time
# Built console assets. The directory's README.md is committed, because
# go:embed fails the build when its pattern matches nothing and a fresh clone
# would otherwise not compile until someone had run npm.
/internal/console/dist/*
!/internal/console/dist/README.md
/console/node_modules/
/console/dist/

# Local development
*.local.yaml
.env
.env.*
!.env.example

# Secrets and keys — nothing of this shape belongs in the repo (R-190, R-194)
*.pem
*.key
!**/testdata/**/*.pem
!**/testdata/**/*.key

# Tooling
.DS_Store
coverage.out
*.test
/gen-api-types
vulns.json

# Python bytecode. Scorecard flags any committed binary (Binary-Artifacts).
__pycache__/
*.py[cod]

# Load harness output (test/load/README.md): results, reports, the built binary
/test/load/out/
