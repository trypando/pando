{
  "name": "pando-console",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/vendor-design.mjs",
    "dev": "vite",
    "prebuild": "node scripts/clean-dist.mjs && node scripts/vendor-design.mjs && npm run types",
    "build": "tsc --noEmit && vite build",
    "types": "go run ../cmd/gen-api-types",
    "lint": "eslint src",
    "test": "vitest run",
    "precheck": "node scripts/vendor-design.mjs && npm run types",
    "check": "npm run lint && tsc --noEmit && npm run test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-router": "1.170.39",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^9.38.0",
    "eslint-plugin-react": "^7.37.5",
    "oxlint": "1.86.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  }
}
