{
  "events": [
    {
      "type": "adapter.configured",
      "description": "An adapter was added or changed. It applies after a restart.",
      "scope": "install",
      "source": "audit",
      "fields": [
        {
          "name": "category",
          "description": "The adapter's category."
        },
        {
          "name": "kind",
          "description": "The adapter's kind."
        },
        {
          "name": "credentials_changed",
          "description": "Whether a credential changed."
        }
      ]
    },
    {
      "type": "adapter.recovered",
      "description": "An adapter's health check passes again.",
      "scope": "install",
      "source": "core",
      "fields": [
        {
          "name": "adapter_id",
          "description": "The adapter."
        },
        {
          "name": "category",
          "description": "Its category."
        }
      ]
    },
    {
      "type": "adapter.unhealthy",
      "description": "An adapter's health check started failing.",
      "scope": "install",
      "source": "core",
      "fields": [
        {
          "name": "adapter_id",
          "description": "The adapter."
        },
        {
          "name": "category",
          "description": "Its category."
        },
        {
          "name": "reason",
          "description": "Why, in words a person can act on."
        }
      ]
    },
    {
      "type": "app.created",
      "description": "An app was created.",
      "scope": "app",
      "source": "audit",
      "fields": [
        {
          "name": "name",
          "description": "The app's name."
        },
        {
          "name": "slug",
          "description": "The app's slug."
        }
      ]
    },
    {
      "type": "app.deleted",
      "description": "An app was deleted. Its volumes are kept.",
      "scope": "app",
      "source": "audit",
      "fields": [
        {
          "name": "backup_id",
          "description": "The backup's ID, bkp_…."
        },
        {
          "name": "volumes_discarded",
          "description": "Whether its volumes were discarded rather than kept."
        },
        {
          "name": "reason",
          "description": "idle when Pando deleted it because nobody used it."
        }
      ]
    },
    {
      "type": "app.disk_stopped",
      "description": "Pando stopped an app that stayed over its disk limit. It stays stopped until somebody starts it.",
      "scope": "app",
      "source": "audit",
      "fields": [
        {
          "name": "used_bytes",
          "description": "What the app's containers and volumes hold."
        },
        {
          "name": "limit_bytes",
          "description": "Its disk limit."
        }
      ]
    },
    {
      "type": "app.disk_warning",
      "description": "An app is near its disk limit, or over it and will be stopped if it still is at the next reading.",
      "scope": "app",
      "source": "audit",
      "fields": [
        {
          "name": "used_bytes",
          "description": "What the app's containers and volumes hold."
        },
        {
          "name": "limit_bytes",
          "description": "Its disk limit."
        },
        {
          "name": "over",
          "description": "true when it is over the limit, false when it is near it."
        }
      ]
    },
    {
      "type": "app.exec",
      "description": "Somebody opened a shell in one of an app's workloads. The command is named; what was typed is not recorded.",
      "scope": "app",
      "source": "audit",
      "fields": [
        {
          "name": "workload",
          "description": "The workload."
        },
        {
          "name": "command",
          "description": "The command the session started."
        }
      ]
    },
    {
      "type": "app.failed",
      "description": "Pando stopped trying to bring an app back after repeated failures. It stays failed until somebody deploys it.",
      "scope": "app",
      "source": "audit",
      "fields": [
        {
          "name": "reason",
          "description": "Why, in words a person can act on."
        },
        {
          "name": "failures",
          "description": "How many attempts failed."
        },
        {
          "name": "window",
          "description": "Over how long."
        }
      ]
    },
    {
      "type": "app.idle_notice",
      "description": "Nobody has used an app for a while, and its owner was told Pando will stop or delete it.",
      "scope": "app",
      "source": "audit",
      "fields": [
        {
          "name": "action",
          "description": "stop or delete."
        },
        {
          "name": "days",
          "description": "The idle setting in force."
        },
        {
          "name": "last_activity",
          "description": "When the app was last used, deployed or started."
        },
        {
          "name": "action_at",
          "description": "When Pando will act."
        }
      ]
    },
    {
      "type": "app.idle_stopped",
      "description": "Pando stopped an app nobody had used. It stays stopped until somebody starts it.",
      "scope": "app",
      "source": "audit",
      "fields": [
        {
          "name": "days",
          "description": "The idle setting in force."
        },
        {
          "name": "last_activity",
          "description": "When the app was last used, deployed or started."
        }
      ]
    },
    {
      "type": "app.restarted",
      "description": "Somebody restarted an app.",
      "scope": "app",
      "source": "audit",
      "fields": []
    },
    {
      "type": "app.restored",
      "description": "An app's data was restored from a backup.",
      "scope": "app",
      "source": "audit",
      "fields": [
        {
          "name": "volumes",
          "description": "The volumes restored."
        }
      ]
    },
    {
      "type": "app.secret_written",
      "description": "An app's secret was set or changed. The value is never in an event.",
      "scope": "app",
      "source": "audit",
      "fields": [
        {
          "name": "key",
          "description": "The secret's name."
        }
      ]
    },
    {
      "type": "app.state_changed",
      "description": "An app moved from one state to another: running, degraded, failed, stopped, deploying and the rest. A health change is a move between running and degraded.",
      "scope": "app",
      "source": "state",
      "fields": [
        {
          "name": "from",
          "description": "The state it was in."
        },
        {
          "name": "to",
          "description": "The state it is in now."
        }
      ]
    },
    {
      "type": "backup.created",
      "description": "A backup was taken. A disaster-recovery bundle has no app, and reaches install-wide subscriptions only.",
      "scope": "app",
      "source": "state",
      "fields": [
        {
          "name": "backup_id",
          "description": "The backup's ID, bkp_…."
        },
        {
          "name": "kind",
          "description": "rolling, on_delete or dr_bundle."
        },
        {
          "name": "size_bytes",
          "description": "Its size."
        }
      ]
    },
    {
      "type": "backup.failed",
      "description": "A backup was not taken.",
      "scope": "app",
      "source": "state",
      "fields": [
        {
          "name": "scheduled",
          "description": "True for the hourly backup nobody asked for."
        },
        {
          "name": "message",
          "description": "What went wrong."
        },
        {
          "name": "remedy",
          "description": "What to do about it."
        },
        {
          "name": "reason",
          "description": "Why, in words a person can act on."
        }
      ]
    },
    {
      "type": "backup.restored",
      "description": "A backup was restored.",
      "scope": "app",
      "source": "audit",
      "fields": [
        {
          "name": "restored",
          "description": "What was restored."
        }
      ]
    },
    {
      "type": "deploy.approved",
      "description": "Somebody approved a deploy.",
      "scope": "app",
      "source": "audit",
      "fields": [
        {
          "name": "approvals",
          "description": "Approvals so far."
        },
        {
          "name": "approvals_required",
          "description": "How many it needs."
        }
      ]
    },
    {
      "type": "deploy.failed",
      "description": "A deploy failed.",
      "scope": "app",
      "source": "state",
      "fields": [
        {
          "name": "deployment_id",
          "description": "The deploy's ID, dep_…."
        },
        {
          "name": "spec_id",
          "description": "The revision that did not deploy."
        },
        {
          "name": "trigger",
          "description": "What started it."
        },
        {
          "name": "error_code",
          "description": "The stable error code."
        },
        {
          "name": "message",
          "description": "What went wrong."
        }
      ]
    },
    {
      "type": "deploy.rejected",
      "description": "Somebody rejected a deploy.",
      "scope": "app",
      "source": "audit",
      "fields": [
        {
          "name": "reason",
          "description": "Why, in words a person can act on."
        }
      ]
    },
    {
      "type": "deploy.requested",
      "description": "A deploy is waiting for approval.",
      "scope": "app",
      "source": "audit",
      "fields": [
        {
          "name": "spec_revision",
          "description": "The revision to deploy."
        },
        {
          "name": "trigger",
          "description": "What started it."
        },
        {
          "name": "reasons",
          "description": "Why it needs approval."
        },
        {
          "name": "approvals_required",
          "description": "How many approvals it needs."
        }
      ]
    },
    {
      "type": "deploy.started",
      "description": "A deploy started.",
      "scope": "app",
      "source": "audit",
      "fields": [
        {
          "name": "spec_revision",
          "description": "The revision being deployed."
        },
        {
          "name": "trigger",
          "description": "What started it."
        }
      ]
    },
    {
      "type": "deploy.succeeded",
      "description": "A deploy finished and the app is running the new revision.",
      "scope": "app",
      "source": "state",
      "fields": [
        {
          "name": "deployment_id",
          "description": "The deploy's ID, dep_…."
        },
        {
          "name": "spec_id",
          "description": "The revision deployed."
        },
        {
          "name": "trigger",
          "description": "What started it."
        }
      ]
    },
    {
      "type": "grant.created",
      "description": "Somebody was given access. On an app, this is a share; install-wide, a role.",
      "scope": "app",
      "source": "audit",
      "fields": [
        {
          "name": "plane",
          "description": "control or data."
        },
        {
          "name": "role_id",
          "description": "The role granted, on the control plane."
        },
        {
          "name": "principal_kind",
          "description": "user, group, token or anonymous."
        },
        {
          "name": "principal_id",
          "description": "Who was given access."
        },
        {
          "name": "passcode",
          "description": "Whether sharing with everyone needs a passcode."
        }
      ]
    },
    {
      "type": "grant.deleted",
      "description": "Access was taken away.",
      "scope": "app",
      "source": "audit",
      "fields": [
        {
          "name": "scope",
          "description": "app or install."
        }
      ]
    },
    {
      "type": "grant.updated",
      "description": "A grant's role changed.",
      "scope": "app",
      "source": "audit",
      "fields": [
        {
          "name": "role_id",
          "description": "The new role."
        }
      ]
    },
    {
      "type": "pando.upgrade_failed",
      "description": "An in-place upgrade did not finish.",
      "scope": "install",
      "source": "audit",
      "fields": [
        {
          "name": "from",
          "description": "The version running."
        },
        {
          "name": "to",
          "description": "The version attempted."
        },
        {
          "name": "reason",
          "description": "Why, in words a person can act on."
        }
      ]
    },
    {
      "type": "pando.upgraded",
      "description": "Pando upgraded itself in place.",
      "scope": "install",
      "source": "audit",
      "fields": [
        {
          "name": "from",
          "description": "The version before."
        },
        {
          "name": "to",
          "description": "The version now."
        }
      ]
    },
    {
      "type": "policy.updated",
      "description": "Host policy changed. The new policy is read from GET /api/v1/policy; the event says only that it changed.",
      "scope": "install",
      "source": "audit",
      "fields": []
    },
    {
      "type": "security.insecure",
      "description": "An app's score is below the installation's minimum.",
      "scope": "app",
      "source": "audit",
      "fields": [
        {
          "name": "grace_hours",
          "description": "Hours before Pando acts."
        },
        {
          "name": "action",
          "description": "What Pando does then."
        }
      ]
    },
    {
      "type": "security.recovered",
      "description": "An app's score is back at or above the minimum.",
      "scope": "app",
      "source": "audit",
      "fields": []
    },
    {
      "type": "security.scan_failed",
      "description": "A scan did not finish.",
      "scope": "app",
      "source": "audit",
      "fields": [
        {
          "name": "reason",
          "description": "Why, in words a person can act on."
        }
      ]
    },
    {
      "type": "security.scanned",
      "description": "An app was scanned and has a security score.",
      "scope": "app",
      "source": "audit",
      "fields": [
        {
          "name": "score",
          "description": "The security score, 0 to 100."
        },
        {
          "name": "critical",
          "description": "Critical findings."
        },
        {
          "name": "high",
          "description": "High findings."
        },
        {
          "name": "medium",
          "description": "Medium findings."
        },
        {
          "name": "low",
          "description": "Low and unrated findings."
        },
        {
          "name": "spec_id",
          "description": "The revision scanned."
        }
      ]
    },
    {
      "type": "security.stopped",
      "description": "Pando stopped an app that stayed below the installation's minimum score.",
      "scope": "app",
      "source": "audit",
      "fields": [
        {
          "name": "grace_hours",
          "description": "The grace period that passed."
        },
        {
          "name": "insecure_since",
          "description": "When it fell below."
        }
      ]
    },
    {
      "type": "subscription.disabled",
      "description": "Pando turned a subscription off because its endpoint failed every delivery for a day. On an app subscription the event names the app; otherwise it is install-wide.",
      "scope": "app",
      "source": "audit",
      "fields": [
        {
          "name": "subscription_id",
          "description": "The subscription, sub_…."
        },
        {
          "name": "reason",
          "description": "Why, in words a person can act on."
        }
      ]
    },
    {
      "type": "subscription.test",
      "description": "A test delivery somebody asked for. Sent only to the subscription it tests, whatever its filter says.",
      "scope": "install",
      "source": "core",
      "fields": [
        {
          "name": "subscription_id",
          "description": "The subscription being tested."
        }
      ]
    },
    {
      "type": "token.created",
      "description": "An API token was created. The token itself is never in an event.",
      "scope": "install",
      "source": "audit",
      "fields": [
        {
          "name": "name",
          "description": "The token's name."
        },
        {
          "name": "kind",
          "description": "delegated or account."
        }
      ]
    },
    {
      "type": "token.revoked",
      "description": "An API token was revoked.",
      "scope": "install",
      "source": "audit",
      "fields": []
    },
    {
      "type": "user.created",
      "description": "An account was created.",
      "scope": "install",
      "source": "audit",
      "fields": [
        {
          "name": "via",
          "description": "How it was created."
        },
        {
          "name": "adapter_id",
          "description": "The identity provider."
        }
      ]
    },
    {
      "type": "user.deleted",
      "description": "An account was deleted.",
      "scope": "install",
      "source": "audit",
      "fields": [
        {
          "name": "username",
          "description": "Its username."
        }
      ]
    },
    {
      "type": "user.sign_in_denied",
      "description": "A sign-in was refused.",
      "scope": "install",
      "source": "audit",
      "fields": [
        {
          "name": "reason",
          "description": "Why, in words a person can act on."
        },
        {
          "name": "adapter_id",
          "description": "The identity provider."
        }
      ]
    },
    {
      "type": "user.signed_in",
      "description": "Somebody signed in.",
      "scope": "install",
      "source": "audit",
      "fields": [
        {
          "name": "user_id",
          "description": "The account's ID."
        },
        {
          "name": "via",
          "description": "How: password, or an identity provider."
        },
        {
          "name": "adapter_id",
          "description": "The identity provider."
        }
      ]
    }
  ]
}
